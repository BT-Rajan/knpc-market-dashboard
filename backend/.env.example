DB_HOST=localhost
DB_PORT=3306
DB_NAME=knpc_dashboard
DB_USER=root
DB_PASSWORD=

SCRAPE_FREQUENCY_MINUTES=30

# Long random string, unique per deployment. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Bcrypt hashes only -- never put plaintext passwords here or anywhere else.
# Generate each with:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
USER_PASSWORD_HASH=

# Fernet key used to encrypt the Gmail app password at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Comma-separated. Only needed if the frontend is hosted on a different
# origin than the API; same-origin monolith deploys can leave the default.
ALLOWED_ORIGINS=http://localhost:5173

DEEPSEEK_API_KEY=
CLAUDE_API_KEY=

# Gmail sender account for the distribution-list emails is set from the
# Admin -> Email -> Gmail Settings panel (stored encrypted in the DB), not
# here -- use a Gmail App Password, not the account password.
